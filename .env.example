# ============================================================
# Environment Variables — copy to .env.local and fill in values.
# NEVER commit .env.local or any file with real secrets to git.
# ============================================================

# ── Supabase (required) ──────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# SERVICE ROLE KEY — server-side only, NEVER expose to the browser.
# Used only in createAdminClient() for privileged server actions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Site URL (required for invite emails and CORS) ────────────────────────
# Production: your real domain e.g. https://www.caffeinecoffee.com
# Development: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://www.caffeinecoffee.com

# ── Email (Resend) ────────────────────────────────────────────────────────
# Get your API key at https://resend.com — keep this server-side only.
RESEND_API_KEY=re_your_resend_key_here

# The "from" address shown on outbound contact-form emails.
# Must be a domain you've verified in Resend.
CONTACT_FORM_FROM_EMAIL=no-reply@caffeinecoffee.com

# Where contact form notifications are delivered.
CONTACT_FORM_TO_EMAIL=hello@caffeinecoffee.com

# ── reCAPTCHA v3 (optional but recommended) ───────────────────────────────
# https://www.google.com/recaptcha/admin
# Public site key — safe to expose (used by the browser widget).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-site-key

# Secret key — server-side only, NEVER expose to the browser.
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# ── NODE_ENV (set automatically by Next.js/Vercel) ────────────────────────
# development | production
# NODE_ENV=production
